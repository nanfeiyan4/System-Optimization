+//===- bolt/Passes/CacheConflictPadding.h -----------------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Declares the CacheConflictPadding pass. The pass shifts hot functions inside
+// their 4KB page so that they do not map to the same L1 instruction cache sets.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef BOLT_PASSES_CACHECONFLICTPADDING_H
+#define BOLT_PASSES_CACHECONFLICTPADDING_H
+
+#include "bolt/Passes/BinaryPasses.h"
+
+namespace llvm {
+namespace bolt {
+
+class CacheConflictPadding : public BinaryFunctionPass {
+public:
+  explicit CacheConflictPadding() : BinaryFunctionPass(false) {}
+
+  const char *getName() const override { return "cache-conflict-padding"; }
+
+  Error runOnFunctions(BinaryContext &BC) override;
+};
+
+/// Returns the number of padding bytes that the CacheConflictPadding pass
+/// wants to insert before \p Function, or 0. Consumed by the code emitter.
+size_t getConflictPaddingBefore(const BinaryFunction &Function);
+
+} // namespace bolt
+} // namespace llvm
+
+#endif
