diff --git a/bolt/test/X86/icache-conflict-pad.c b/bolt/test/X86/icache-conflict-pad.c
new file mode 100644
index 000000000..9f9944514
--- /dev/null
+++ b/bolt/test/X86/icache-conflict-pad.c
@@ -0,0 +1,43 @@
+// Check that the L1i conflict padding pass never changes the output when there
+// is no profile, i.e. when no hot code can be spread over the cache sets.
+//
+// RUN: %clang %cflags -O2 -Wl,--emit-relocs -o %t.exe %s
+// RUN: llvm-bolt %t.exe -o %t.ref --no-huge-pages > /dev/null 2>&1
+// RUN: llvm-bolt %t.exe -o %t.pad --no-huge-pages --icache-conflict-pad 2>&1 | FileCheck %s --check-prefix=NOOP
+// RUN: llvm-objcopy --dump-section=.text=%t.ref.text %t.ref
+// RUN: llvm-objcopy --dump-section=.text=%t.pad.text %t.pad
+// RUN: cmp %t.ref.text %t.pad.text
+//
+// RUN: llvm-bolt --help | FileCheck %s --check-prefix=HELP
+
+// HELP-DAG: --icache-conflict-pad
+// HELP-DAG: --icache-sets
+// HELP-DAG: --icache-ways
+// HELP-DAG: --icache-line
+// HELP-DAG: --icache-pad-budget
+// HELP-DAG: --icache-min-conflict-ratio
+// HELP-DAG: --icache-max-pad-pct
+
+// NOOP: BOLT-INFO: cache-conflict-padding: not enough hot functions
+
+volatile long sink;
+
+__attribute__((noinline)) long f0(long s) {
+  for (int i = 0; i < 64; i++)
+    s = s * 3 + i;
+  return s;
+}
+
+__attribute__((noinline)) long f1(long s) {
+  for (int i = 0; i < 64; i++)
+    s ^= s >> 5;
+  return s;
+}
+
+int main(void) {
+  long r = 1;
+  for (int i = 0; i < 100; i++)
+    r += f0(i) + f1(i);
+  sink = r;
+  return 0;
+}
